{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terrazza-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terrazza-invitations",
      "database_id": "b9ef33d7-434b-4b0f-943d-5a4da77af254"
    }
  ]
}
